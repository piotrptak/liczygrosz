{
  "expo": {
    "name": "LiczyGrosz",
    "slug": "liczygrosz",
    "version": "1.0.0",
    "description": "Prosty tracker wydatków synchronizowany między telefonem a komputerem.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "liczygrosz",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.liczygrosz.app"
    },
    "android": {
      "package": "com.liczygrosz.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "LiczyGrosz",
      "shortName": "LiczyGrosz",
      "lang": "pl",
      "themeColor": "#4F46E5",
      "backgroundColor": "#F5F6F8"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-sqlite",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
